const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('chinadrivetest-cli v1.0.0 (https://chinadrivetest.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'chinadrivetest.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'chinadrivetest.com', benchmark: "Foreign Driver Licensing Pathways & Statutory Speed/Demerit Benchmarks", rows: SPECS }, null, 2));
